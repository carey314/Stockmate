# StockMate 后端环境变量模板
# 用法：复制成 .env 并填入真实值（.env 已被 .gitignore 排除，绝不提交）
#   cp .env.example .env

# ===== 必填 =====
# 数据库连接。开发用 SQLite；生产可切 MySQL（file:./dev.db 或 mysql://user:pass@host/db）
DATABASE_URL="file:./dev.db"
# JWT 签名密钥。生产务必换成足够长的随机串（如 openssl rand -hex 32）
JWT_SECRET="change-me-to-a-long-random-string"
# 服务端口
PORT=3100

# ===== AI（DeepSeek）：不配也能跑，AI 功能会走本地兜底/明确报未配置 =====
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# ===== 可选 =====
# 运行环境
NODE_ENV="development"
# 时区（钉死本地时区，避免 UTC 机器把凌晨的生意算到前一天）
TZ="Asia/Shanghai"
# 注册闸：设 false 关闭注册（多租户隔离已上线，一般不需要）
# ALLOW_REGISTRATION="true"
# 跳过租户上下文校验（仅种子脚本/特殊维护用，生产不要设）
# ALLOW_NO_TENANT="0"
# Apple 登录校验用的 bundle id
# APPLE_BUNDLE_ID="com.carey.stockmate"
# 数据导出/备份目录
# BACKUP_DIR="./backups"
# 免费 AI 每日额度（核心环节/其他环节），不设=不限
# FREE_AI_DAILY_CORE=""
# FREE_AI_DAILY_OTHER=""

# 阿里云号码认证 PNVS/Dypnsapi（不是普通 Dysmsapi）。只在服务端安全注入凭据。
PNVS_ACCESS_KEY_ID=
PNVS_ACCESS_KEY_SECRET=
# 2026-09-08 用户控制台核验；上线前再次核对获准的签名与三个用途模板。
PNVS_SIGN_NAME=恒创联众
PNVS_TEMPLATE_CODE_LOGIN=100001
PNVS_TEMPLATE_CODE_RESET=100003
PNVS_TEMPLATE_CODE_BIND=100004
# 100002 是换绑模板，首批不开放换绑。平台变量 code/min，验证码由平台生成。
# 可选限额只能调低默认值；失败/超时也占次数。
PNVS_PHONE_DAY_LIMIT=10
PNVS_PHONE_PURPOSE_DAY_LIMIT=5
PNVS_IP_DAY_LIMIT=100
PNVS_IP_PURPOSE_DAY_LIMIT=50

# Apple JWS 通知与交易验签需要真实 App Store Connect appAppleId。
APPLE_APP_ID=
# 旧版 app receipt 校验所需共享密钥；仅服务端安全注入，不提交真实值。
APPLE_SHARED_SECRET=

# 平台运营独立JWT签名密钥（至少32个字符，与商家JWT_SECRET不同；不配置则平台登录503）
PLATFORM_JWT_SECRET=
# 体验码发放材料AES-256-GCM密钥：独立32随机bytes的标准base64。
# 私有配置生成后保管；轮换须先迁移旧批次密文，不得丢弃旧key。禁止填入真实值并提交仓库。
PROMO_CODE_ENCRYPTION_KEY=

# Optional provider-price snapshot: JSON keyed by model; leave empty until actual rates verified.
# Fields: unit=per_million_tokens,currency,input,output,cacheHit (numeric rates).
AI_MODEL_PRICING=
