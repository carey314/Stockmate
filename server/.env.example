# StockMate 后端环境变量模板
# 用法：复制成 .env 并填入真实值（.env 已被 .gitignore 排除，绝不提交）
#   cp .env.example .env

# ===== 必填 =====
# 数据库连接。开发用 SQLite；生产可切 MySQL（file:./dev.db 或 mysql://user:pass@host/db）
DATABASE_URL="file:./dev.db"
# JWT 签名密钥。生产务必换成足够长的随机串（如 openssl rand -hex 32）
JWT_SECRET="change-me-to-a-long-random-string"
# 服务端口
PORT=3100

# ===== AI（DeepSeek）：不配也能跑，AI 功能会走本地兜底/明确报未配置 =====
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# ===== 可选 =====
# 运行环境
NODE_ENV="development"
# 时区（钉死本地时区，避免 UTC 机器把凌晨的生意算到前一天）
TZ="Asia/Shanghai"
# 注册闸：设 false 关闭注册（多租户隔离已上线，一般不需要）
# ALLOW_REGISTRATION="true"
# 跳过租户上下文校验（仅种子脚本/特殊维护用，生产不要设）
# ALLOW_NO_TENANT="0"
# Apple 登录校验用的 bundle id
# APPLE_BUNDLE_ID="com.carey.stockmate"
# 数据导出/备份目录
# BACKUP_DIR="./backups"
# 免费 AI 每日额度（核心环节/其他环节），不设=不限
# FREE_AI_DAILY_CORE=""
# FREE_AI_DAILY_OTHER=""
